// SPDX-License-Identifier: GPL-2.0-only
/*
 * Raspberry Pi 7" DSI touchscreen clone on the Radxa ROCK 3C, mainline kernel.
 *
 * VOP2 vp1 -> dsi1 (+ dsi_dphy1) -> TC358762 bridge -> panel-simple
 * "powertip,ph800480t013-idf02". The panel MCU at i2c3 0x45
 * (rpi-panel-attiny-regulator) powers the bridge and drives the backlight; the
 * FT5426 touch at 0x38 has no IRQ line and uses ft5426_poll.
 *
 * vcc_mipi must stay on: when the kernel switches off unused regulators the
 * panel MCU loses power otherwise.
 *
 * The in-tree tc358762 driver needs the burst-mode patch in tc358762/, or the
 * picture is shifted sideways and wraps around.
 *
 * Tested on Linux 6.18.62 (NixOS 26.05).
 */
/dts-v1/;
/plugin/;

/ {
  compatible = "radxa,rock-3c";
};

&{/} {
  rpi_dsi_panel: panel-rpi-dsi {
    compatible = "powertip,ph800480t013-idf02";
    power-supply = <&rpi_panel_mcu>;
    backlight = <&rpi_panel_mcu>;

    port {
      panel_in_bridge: endpoint {
        remote-endpoint = <&bridge_out_panel>;
      };
    };
  };
};

&vcc_mipi {
  regulator-always-on;
  regulator-boot-on;
};

&i2c3 {
  pinctrl-names = "default";
  pinctrl-0 = <&i2c3m1_xfer>;
  #address-cells = <1>;
  #size-cells = <0>;
  status = "okay";

  rpi_panel_mcu: regulator@45 {
    compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
    reg = <0x45>;
  };

  touchscreen@38 {
    compatible = "focaltech,ft5426-poll";
    reg = <0x38>;
  };
};

&dsi_dphy1 {
  status = "okay";
};

&dsi1 {
  #address-cells = <1>;
  #size-cells = <0>;
  status = "okay";

  bridge@0 {
    compatible = "toshiba,tc358762";
    reg = <0>;
    vddc-supply = <&rpi_panel_mcu>;

    ports {
      #address-cells = <1>;
      #size-cells = <0>;

      port@0 {
        reg = <0>;
        bridge_in_dsi: endpoint {
          remote-endpoint = <&dsi1_out_bridge>;
        };
      };

      port@1 {
        reg = <1>;
        bridge_out_panel: endpoint {
          remote-endpoint = <&panel_in_bridge>;
        };
      };
    };
  };
};

&dsi1_in {
  dsi1_in_vp1: endpoint {
    remote-endpoint = <&vp1_out_dsi1>;
  };
};

&dsi1_out {
  dsi1_out_bridge: endpoint {
    remote-endpoint = <&bridge_in_dsi>;
  };
};

/* reg 6 = ROCKCHIP_VOP2_EP_MIPI1 (dt-bindings/soc/rockchip,vop2.h) */
&vp1 {
  #address-cells = <1>;
  #size-cells = <0>;

  vp1_out_dsi1: endpoint@6 {
    reg = <6>;
    remote-endpoint = <&dsi1_in_vp1>;
  };
};
